      "step_count": "integer",
      "riser_height": "number|null",
      "tread_depth": "number|null",
      "width": "number|null"
    },
    "LANDING": {
      "geometry": "polygon",
      "elevation": "number"
    },
    "STAIRWELL": {
      "geometry": "polygon/void",
      "connected_storeys": "array"
    },
    "HANDRAIL": {
